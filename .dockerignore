# Keep the build context small and free of local state.
.git/
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage*

# State and artifacts belong to volumes, not to the image.
data/*.db
data/*.db-*
data/raw/
data/processed/
data/snapshots/
data/reference/
reports/backtest/*
!reports/backtest/.gitkeep

# Never copy secrets into a layer.
.env
.env.*
!.env.example

tests/
.github/
*.md
!README.md
