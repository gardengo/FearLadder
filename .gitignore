*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# Secrets
.env
.env.*
!.env.example
*.pem
*.key

# Testing / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# Data
# NOTE: data/fear_ladder.db 는 운영상 커밋 대상이므로 무시하지 않는다.
# Operator-supplied reference exports (see data/reference/README.md).
data/reference/*
!data/reference/README.md
*.db-journal
*.db-wal
*.db-shm

# Reports
reports/backtest/*
!reports/backtest/.gitkeep

# Logs
*.log
logs/

# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Git worktrees checked out inside the repository. Orca creates them here, and
# without this a `git add -A` in the main worktree would commit a second copy
# of the whole tree.
/validation/
/.orca-worktree-trash/
