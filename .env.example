# Telegram alert channel (TASK-120). Never commit real values.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: explicit DB path override. Defaults to <repo>/data/fear_ladder.db
FEAR_LADDER_DB=

# Optional: FRED API key, used only if a FRED direct adapter is enabled.
FRED_API_KEY=

# Set to 1 to allow the pipeline to run with RESEARCH_PLACEHOLDER parameters.
# Production / GitHub Actions must leave this unset.
FEAR_LADDER_ALLOW_RESEARCH_PARAMS=
